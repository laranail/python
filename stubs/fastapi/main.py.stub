"""
{{ name }} — a FastAPI service wired to laranail/python's conventions.

Generated by `php artisan laranail::python.make-service {{ name }}`.

Three things here are contracts rather than suggestions. Change them and the
Laravel side stops agreeing with you:

  * /health returns {"status": "healthy"} — the shape laranail.python.services
    .{{ name }}.health_key / healthy_value expect.
  * The callback signature is HMAC-SHA256 over "{timestamp}.{raw_body}", using
    the RAW bytes that go on the wire. Re-encoding the payload before signing
    is the mistake that makes two JSON encoders have to agree byte-for-byte.
  * Long work answers immediately with a task_id and reports completion later.
"""

import hashlib
import hmac
import json
import os
import time
import uuid

import httpx
from fastapi import BackgroundTasks, FastAPI
from pydantic import BaseModel

app = FastAPI(title="{{ name }}")

CALLBACK_SECRET = os.environ.get("PYTHON_CALLBACK_SECRET", "")


@app.get("/health")
def health() -> dict:
    return {"status": "healthy"}


class PredictRequest(BaseModel):
    text: str


@app.post("/predict")
def predict(request: PredictRequest) -> dict:
    """Fast work answers inline."""
    return {"length": len(request.text)}


class SubmitRequest(BaseModel):
    callback_url: str | None = None


@app.post("/submit")
def submit(request: SubmitRequest, background: BackgroundTasks) -> dict:
    """Slow work answers with an id and reports back when it finishes."""
    task_id = str(uuid.uuid4())
    background.add_task(_run, task_id, request.callback_url)
    return {"task_id": task_id, "status": "running"}


def _run(task_id: str, callback_url: str | None) -> None:
    result = {"task_id": task_id, "status": "succeeded", "answer": 42}

    if callback_url:
        _post_signed(callback_url, result)


def _post_signed(url: str, payload: dict) -> None:
    # Sign the exact bytes that are sent. Serialise once, sign that, send that.
    body = json.dumps(payload, separators=(",", ":")).encode()
    timestamp = str(int(time.time()))

    signature = hmac.new(
        CALLBACK_SECRET.encode(),
        f"{timestamp}.".encode() + body,
        hashlib.sha256,
    ).hexdigest()

    httpx.post(
        url,
        content=body,
        headers={
            "Content-Type": "application/json",
            "X-Laranail-Timestamp": timestamp,
            "X-Laranail-Signature": f"sha256={signature}",
            "X-Laranail-Id": payload["task_id"],
        },
        timeout=10,
    )
