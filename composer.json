{
    "name": "laranail/python",
    "description": "A Python bridge for Laravel: call FastAPI/Flask services over HTTP, run scripts in a virtualenv behind a hardened process clamp, and receive HMAC-signed callbacks when the work finishes.",
    "keywords": [
        "laravel",
        "laranail",
        "python",
        "fastapi",
        "flask",
        "bridge",
        "microservices",
        "machine-learning",
        "webhooks",
        "subprocess"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/python",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/python/issues",
        "source": "https://github.com/laranail/python",
        "docs": "https://opensource.simtabi.com/documentation/laranail/python/"
    },
    "require": {
        "php": "^8.4.1 || ^8.5",
        "ext-json": "*",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/process": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laranail/console": "^0.1",
        "laranail/package-tools": "^0.1",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        }
    ],
    "require-dev": {
        "illuminate/queue": "^13.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "ext-curl": "Used by Guzzle for the HTTP transport.",
        "laravel/octane": "Transport state is reset at both Octane request boundaries."
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Python\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Python\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --colors=always",
        "test-coverage": "@test --coverage",
        "test-dirty": "@test --dirty --compact",
        "lint": [
            "@pint",
            "@phpstan",
            "@rector"
        ],
        "pint": "vendor/bin/pint --test",
        "pint-fix": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "audit": "@composer audit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Python\\Providers\\PythonServiceProvider"
            ],
            "aliases": {
                "Python": "Simtabi\\Laranail\\Python\\Facades\\Python"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
